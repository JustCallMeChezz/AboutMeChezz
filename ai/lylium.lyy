const apiUrl =
  "https://api-nanzz.my.id/docs/ai/claude-haiku?text="

const memoryApi =
  "https://api-nanzz.my.id/docs/ai/notegpt?q="

const memoryModel =
  "&model=gemini-3.1-flash-lite-preview"

const corsProxy = "https://corsproxy.io/?"

let conversationHistory = atob(
  ""
)

function getCurrentDateTime() {
  return new Date().toLocaleString("en-US")
}

function trimMemory(maxChars = 1800) {
  if (conversationHistory.length > maxChars) {
    conversationHistory = conversationHistory.slice(-maxChars)
  }
}

function buildChatUrl(prompt) {
  const fullPrompt =
    conversationHistory +
    "\nCurrent date and time: " +
    getCurrentDateTime() +
    "\nUser: " +
    prompt

  return corsProxy + encodeURIComponent(apiUrl + fullPrompt)
}

function buildMemoryUrl() {
  return corsProxy + encodeURIComponent(
    memoryApi + encodeURIComponent(conversationHistory) + memoryModel
  )
}

async function updateMemory() {
  try {
    const res = await fetch(buildMemoryUrl())
    const data = await res.json()

    let summary = data?.result
    if (!summary) return

    summary = summary.trim()

    conversationHistory =
      summary + "\n"
  } catch (err) {
    console.log("memory error", err)
  }
}

async function tryFetchFromApis(prompt) {
  try {
    const res = await fetch(buildChatUrl(prompt))
    const data = await res.json()

    let response = data?.result
    if (!response) return null

    response = response
      .replace(/^"+|"+$/g, "")
      .replace(/\\u001c\{.*$/g, "")
      .replace(/[\u{1F300}-\u{1FAFF}]/gu, "")
      .trim()

    conversationHistory +=
      "User: " + prompt + "\nAI: " + response + "\n"

    trimMemory()

    await updateMemory()

    return response
  } catch (err) {
    console.log(err)
    return null
  }
}