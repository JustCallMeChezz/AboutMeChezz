const apiUrl = "https://api-nanzz.my.id/docs/ai/claude-haiku?text="
const corsProxy = "https://corsproxy.io/?"

let conversationHistory = atob(
  ""
)

function getCurrentDateTime() {
  const now = new Date()
  return now.toLocaleString("en-US")
}

function buildUrl(prompt) {
  const fullPrompt =
    conversationHistory +
    "\nCurrent date and time: " +
    getCurrentDateTime() +
    "\nUser: " +
    prompt

  return corsProxy + encodeURIComponent(apiUrl + fullPrompt)
}

async function tryFetchFromApis(prompt) {
  try {
    const res = await fetch(buildUrl(prompt))
    const data = await res.json()

    let response = data?.result

    if (!response) return null

    response = response
      .replace(/^"+|"+$/g, "")
      .replace(/\\u001c\{.*$/g, "")
      .replace(/[\u{1F300}-\u{1FAFF}]/gu, "")
      .trim()

    conversationHistory +=
      "User: " + prompt + "\nAI: " + response + "\n"

    return response
  } catch (err) {
    console.log(err)
    return null
  }
}