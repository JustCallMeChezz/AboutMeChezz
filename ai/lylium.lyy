const chatApi =
  "https://api-nanzz.my.id/docs/ai/claude-haiku?text="

const memoryApi =
  "https://api-nanzz.my.id/docs/ai/notegpt?q=memory&model=gemini-3.1-flash-lite-preview"

const corsProxy = "https://corsproxy.io/?"

let conversationHistory = atob(
  ""
)

function getCurrentDateTime() {
  const now = new Date()
  return now.toLocaleString("en-US")
}

function trimMemory(maxChars = 2000) {
  if (conversationHistory.length > maxChars) {
    conversationHistory = conversationHistory.slice(-maxChars)
  }
}

function buildChatUrl(prompt) {
  const fullPrompt =
    conversationHistory +
    "\nCurrent date and time: " +
    getCurrentDateTime() +
    "\nUser: " +
    prompt

  return corsProxy + encodeURIComponent(chatApi + fullPrompt)
}

function buildMemoryUrl(text) {
  return corsProxy + encodeURIComponent(memoryApi + "&q=" + encodeURIComponent(text))
}

async function updateMemory(text) {
  try {
    const res = await fetch(buildMemoryUrl(text))
    const data = await res.json()

    const memory = data?.result

    if (memory) {
      conversationHistory = memory
        .replace(/^"+|"+$/g, "")
        .trim()
    }
  } catch (err) {
    console.log(err)
  }
}

async function tryFetchFromApis(prompt) {
  try {
    const res = await fetch(buildChatUrl(prompt))
    const data = await res.json()

    let response = data?.result
    if (!response) return null

    response = response
      .replace(/^"+|"+$/g, "")
      .replace(/\\u001c\{.*$/g, "")
      .replace(/[\u{1F300}-\u{1FAFF}]/gu, "")
      .trim()

    await updateMemory(
      conversationHistory +
      "\nUser: " + prompt +
      "\nAI: " + response
    )

    return response
  } catch (err) {
    console.log(err)
    return null
  }
}